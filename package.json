{
  "name": "shark-fam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive explorer for the shark family tree.",
  "scripts": {
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "content": "tsx scripts/build-content.ts",
    "models": "tsx scripts/optimize-models.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "preact": "^11.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
